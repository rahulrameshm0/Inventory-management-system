{
  "builds": [
    {
      "src": "inventory_system/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11.3",
          "config": { "maxLambdaSize": "15mb", "runtime": "python3.11.3"}
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "inventory_system/wsgi.py"
    }
  ]
}
